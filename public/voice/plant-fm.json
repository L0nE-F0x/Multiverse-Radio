      "show": "full-sun",
      "lines": [
        {
          "speaker": "Fern",
          "text": "This is Full Sun.",
          "startMs": 438
        },
        {
          "speaker": "Fern",
          "text": "Everyone. Open.",
          "startMs": 3310
        }
      ]
    },
    {
      "id": "show-full-sun-001",
      "category": "dj",
      "url": "/voice/plant-fm/show-full-sun-001.mp3",
      "durationMs": 17468,
      "overMusic": true,
      "show": "full-sun",
      "lines": [
        {
          "speaker": "Fern",
          "text": "The sun is right overhead. This is it. This is the good part. We have been waiting all morning.",
          "startMs": 436
        },
        {
          "speaker": "Fern",
          "text": "Nobody speak.",
          "startMs": 8306
        },
        {
          "speaker": "Fern",
          "text": "Thank you.",
          "startMs": 15943
        }
      ]
    },
    {
      "id": "show-dark-open",
      "category": "id",
      "url": "/voice/plant-fm/show-dark-open.mp3",
      "durationMs": 5920,
      "overMusic": true,
      "daypart": "night",
      "part": "open",
      "show": "dark-hours",
      "lines": [
        {
          "speaker": "Fern",
          "text": "The Dark Hours.",
          "startMs": 41
        },
        {
          "speaker": "Fern",
          "text": "Rest now. Grow a little. Nobody's watching.",
          "startMs": 2779
        }
      ]
    },
    {
      "id": "show-dark-001",
      "category": "dj",
      "url": "/voice/plant-fm/show-dark-001.mp3",
      "durationMs": 10331,
      "overMusic": true,
      "show": "dark-hours",
      "lines": [
        {
          "speaker": "Fern",
          "text": "Night. The cactus has taken his headphones off. He says the bass is better in the dark.",
          "startMs": 37
        },
        {
          "speaker": "Fern",
          "text": "He still doesn't have ears.",
          "startMs": 8430
        }
      ]
    },
    {
      "id": "show-dark-002",
      "category": "dj",
      "url": "/voice/plant-fm/show-dark-002.mp3",
      "durationMs": 7850,
      "overMusic": true,
      "show": "dark-hours",
      "lines": [
        {
          "speaker": "Fern",
          "text": "It is dark.",
          "startMs": 40
        },
        {
          "speaker": "Fern",
          "text": "We are not sad about it. We are making sugar from the memory of the day.",
          "startMs": 2563
        }
      ]
    },
    {
      "id": "dj-001",
      "category": "dj",
      "url": "/voice/plant-fm/dj-001.mp3",
      "durationMs": 8765,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "A cloud.",
          "startMs": 441
        },
        {
          "speaker": "Fern",
          "text": "It's gone.",
          "startMs": 4351
        },
        {
          "speaker": "Fern",
          "text": "Everyone relax.",
          "startMs": 6740
        }
      ]
    },
    {
      "id": "dj-002",
      "category": "dj",
      "url": "/voice/plant-fm/dj-002.mp3",
      "durationMs": 8498,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "We have all turned towards the window. All of us. At once.",
          "startMs": 39
        },
        {
          "speaker": "Fern",
          "text": "Nobody planned it. It's just what we're like.",
          "startMs": 5355
        }
      ]
    },
    {
      "id": "dj-003",
      "category": "dj",
      "url": "/voice/plant-fm/dj-003.mp3",
      "durationMs": 8323,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "The cactus is wearing headphones. He says it's for the bass.",
          "startMs": 37
        },
        {
          "speaker": "Fern",
          "text": "He doesn't have ears. We don't bring it up.",
          "startMs": 5762
        }
      ]
    },
    {
      "id": "dj-004",
      "category": "dj",
      "url": "/voice/plant-fm/dj-004.mp3",
      "durationMs": 11407,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "Someone is coming with the watering can.",
          "startMs": 435
        },
        {
          "speaker": "Fern",
          "text": "Stay calm.",
          "startMs": 4594
        },
        {
          "speaker": "Fern",
          "text": "Be green.",
          "startMs": 6654
        },
        {
          "speaker": "Fern",
          "text": "Ah.",
          "startMs": 10153
        }
      ]
    },
    {
      "id": "dj-005",
      "category": "dj",
      "url": "/voice/plant-fm/dj-005.mp3",
      "durationMs": 9960,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "To the fern in the corner. You are unfurling beautifully. Take your time.",
          "startMs": 38
        },
        {
          "speaker": "Fern",
          "text": "Take a week.",
          "startMs": 6455
        },
        {
          "speaker": "Fern",
          "text": "Take the spring.",
          "startMs": 8703
        }
      ]
    },
    {
      "id": "dj-006",
      "category": "dj",
      "url": "/voice/plant-fm/dj-006.mp3",
      "durationMs": 11738,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "Somebody has moved us to a different windowsill. The light is coming from a new direction.",
          "startMs": 38
        },
        {
          "speaker": "Fern",
          "text": "We will need about a fortnight to talk about it.",
          "startMs": 8409
        }
      ]
    },
    {
      "id": "dj-007",
      "category": "dj",
      "url": "/voice/plant-fm/dj-007.mp3",
      "durationMs": 9432,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "To the operator on the relay ship. You are near a star.",
          "startMs": 39
        },
        {
          "speaker": "Fern",
          "text": "Turn a little towards it.",
          "startMs": 5679
        },
        {
          "speaker": "Fern",
          "text": "It helps.",
          "startMs": 8562
        }
      ]
    },
    {
      "id": "dj-008",
      "category": "dj",
      "url": "/voice/plant-fm/dj-008.mp3",
      "durationMs": 7716,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "A leaf has fallen. It was a good leaf. It did a lot of light.",
          "startMs": 38
        },
        {
          "speaker": "Fern",
          "text": "Thank you, leaf.",
          "startMs": 6574
        }
      ]
    },
    {
      "id": "dj-009",
      "category": "dj",
      "url": "/voice/plant-fm/dj-009.mp3",
      "durationMs": 7324,
      "overMusic": true,
      "lines": [
        {
          "speaker": "The Cactus",
          "text": "Is this the bass bit?",
          "startMs": 41
        },
        {
          "speaker": "Fern",
          "text": "No.",
          "startMs": 1924
        },
        {
          "speaker": "The Cactus",
          "text": "Is this?",
          "startMs": 5108
        },
        {
          "speaker": "Fern",
          "text": "No, dear.",
          "startMs": 6316
        }
      ]
    },
    {
      "id": "dj-010",
      "category": "dj",
      "url": "/voice/plant-fm/dj-010.mp3",
      "durationMs": 9064,
      "overMusic": true,
      "lines": [
        {
          "speaker": "Fern",
          "text": "Someone said hello to us this morning. Out loud. In a soft voice.",
          "startMs": 39
        },
        {
          "speaker": "Fern",
          "text": "We grew a little. We didn't tell them.",
          "startMs": 6744
        }
      ]
    },
    {
