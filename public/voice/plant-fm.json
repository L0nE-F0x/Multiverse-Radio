        }
      ]
    },
    {
      "id": "show-first-light-001",
      "category": "dj",
      "url": "/voice/plant-fm/show-first-light-001.mp3",
      "durationMs": 13025,
      "overMusic": true,
      "show": "first-light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "The first light is on the top shelf. The orchid has it. The orchid always has it first.",
          "startMs": 437
        },
        {
          "speaker": "Fern",
          "text": "We don't mind.",
          "startMs": 8735
        },
        {
          "speaker": "Fern",
          "text": "We mind a little.",
          "startMs": 11273
        }
      ]
    },
    {
      "id": "show-full-sun-open",
      "category": "id",
      "url": "/voice/plant-fm/show-full-sun-open.mp3",
