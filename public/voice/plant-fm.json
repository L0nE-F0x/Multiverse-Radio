    },
    {
      "id": "light-001",
      "category": "weather",
      "url": "/voice/plant-fm/light-001.mp3",
      "durationMs": 12019,
      "overMusic": false,
      "part": "body",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "Light from the window. Good. Coming in at an angle. Some of it is landing on the floor.",
          "startMs": 439
        },
        {
          "speaker": "Fern",
          "text": "The floor doesn't need it. We don't say anything.",
          "startMs": 8085
        }
      ]
    },
    {
      "id": "light-002",
      "category": "weather",
      "url": "/voice/plant-fm/light-002.mp3",
      "durationMs": 7487,
      "overMusic": false,
      "part": "body",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "Light from the lamp. Warm. Not the sun.",
          "startMs": 437
        },
        {
          "speaker": "Fern",
          "text": "But trying. We appreciate the effort.",
          "startMs": 4366
        }
      ]
    },
    {
      "id": "light-003",
      "category": "weather",
      "url": "/voice/plant-fm/light-003.mp3",
      "durationMs": 8197,
      "overMusic": false,
      "part": "body",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "Dust in the sunbeam. Lots of it. Moving very slowly.",
          "startMs": 438
        },
        {
          "speaker": "Fern",
          "text": "Like us. We feel seen.",
          "startMs": 5759
        }
      ]
    },
    {
      "id": "light-004",
      "category": "weather",
      "url": "/voice/plant-fm/light-004.mp3",
      "durationMs": 9074,
      "overMusic": false,
      "part": "body",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "Light from the fridge. Briefly. At night. When somebody opens it.",
          "startMs": 436
        },
        {
          "speaker": "Fern",
          "text": "It's not much. We'll take it.",
          "startMs": 6394
        }
      ]
    },
    {
      "id": "light-005",
      "category": "weather",
      "url": "/voice/plant-fm/light-005.mp3",
      "durationMs": 10003,
      "overMusic": false,
      "part": "body",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "The sun has gone behind the house next door.",
          "startMs": 438
        },
        {
          "speaker": "Fern",
          "text": "It will come back. It always comes back. We lean, and we wait.",
          "startMs": 4963
        }
      ]
    },
    {
      "id": "light-006",
      "category": "weather",
      "url": "/voice/plant-fm/light-006.mp3",
      "durationMs": 10187,
      "overMusic": false,
      "part": "body",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "Light from a screen, very late. Blue. Thin. Somebody is up, reading something.",
          "startMs": 439
        },
        {
          "speaker": "Fern",
          "text": "We hope it's good. Go to bed soon.",
          "startMs": 7227
        }
      ]
    },
    {
      "id": "light-close-1",
      "category": "weather",
      "url": "/voice/plant-fm/light-close-1.mp3",
      "durationMs": 4540,
      "overMusic": false,
      "part": "close",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "That is all the light.",
          "startMs": 441
        },
        {
          "speaker": "Fern",
          "text": "Thank you.",
          "startMs": 3014
        }
      ]
    },
    {
      "id": "light-close-2",
      "category": "weather",
      "url": "/voice/plant-fm/light-close-2.mp3",
      "durationMs": 5148,
      "overMusic": false,
      "part": "close",
      "kit": "light",
      "lines": [
        {
          "speaker": "Fern",
          "text": "More light later. Probably.",
          "startMs": 437
        },
        {
          "speaker": "Fern",
          "text": "Grow.",
          "startMs": 3791
        }
      ]
    },
    {
      "id": "halloween-1",
      "category": "dj",
      "url": "/voice/plant-fm/halloween-1.mp3",
      "durationMs": 16924,
      "title": "The Pumpkin",
      "overMusic": true,
      "dates": [
        "10-24",
        "10-25",
        "10-26",
        "10-27",
        "10-28",
        "10-29",
        "10-30",
        "10-31"
      ],
      "lines": [
        {
          "speaker": "Fern",
          "text": "A pumpkin has joined us on the windowsill.",
          "startMs": 37
        },
        {
          "speaker": "Fern",
          "text": "It is very big. Very orange.",
          "startMs": 4529
        },
        {
          "speaker": "Fern",
          "text": "Somebody has carved a face into it.",
          "startMs": 8487
        },
        {
          "speaker": "Fern",
          "text": "We are not going to talk about that.",
          "startMs": 14362
        }
      ]
    },
    {
      "id": "halloween-2",
      "category": "dj",
      "url": "/voice/plant-fm/halloween-2.mp3",
      "durationMs": 9674,
      "title": "The Candle",
      "overMusic": true,
      "dates": [
        "10-24",
        "10-25",
        "10-26",
        "10-27",
        "10-28",
        "10-29",
        "10-30",
        "10-31"
      ],
      "lines": [
        {
          "speaker": "Fern",
          "text": "There is a candle inside the pumpkin.",
          "startMs": 37
        },
        {
          "speaker": "Fern",
          "text": "It is light.",
          "startMs": 4095
        },
        {
          "speaker": "Fern",
          "text": "We have decided to forgive everything.",
          "startMs": 7115
        }
      ]
    },
