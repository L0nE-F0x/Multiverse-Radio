        },
        {
          "speaker": "The Counter",
          "text": "Ten.",
          "startMs": 4383
        },
        {
          "speaker": "The Counter",
          "text": "Nine.",
          "startMs": 5952
        },
        {
          "speaker": "The Counter",
          "text": "Eight.",
          "startMs": 7594
        },
        {
          "speaker": "The Counter",
          "text": "This is a countdown. Nothing happens at the end. You will simply be a little sleepier.",
          "startMs": 9368
        },
        {
          "speaker": "The Counter",
          "text": "You do not have to count along. We will do the counting. That is what we are for.",
          "startMs": 15612
        },
        {
          "speaker": "The Counter",
          "text": "Seven.",
          "startMs": 21476
        },
        {
          "speaker": "The Counter",
          "text": "Six. Five. Four.",
          "startMs": 23131
        },
        {
          "speaker": "The Counter",
          "text": "Three. Two.",
          "startMs": 25519
        },
        {
          "speaker": "The Counter",
          "text": "One.",
          "startMs": 27830
        },
        {
          "speaker": "The Counter",
          "text": "There.",
          "startMs": 30386
        },
        {
          "speaker": "The Counter",
          "text": "End of message.",
          "startMs": 31292
        }
      ]
    },
