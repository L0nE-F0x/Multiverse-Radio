    {
      "id": "story-004",
      "category": "story",
      "url": "/voice/substation-null/story-004.mp3",
      "durationMs": 30261,
      "title": "Incident Report: One Second",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Null",
          "text": "Incident report.",
          "startMs": 41
        },
        {
          "speaker": "Null",
          "text": "At two fourteen, the music stopped. For one second.",
          "startMs": 2690
        },
        {
          "speaker": "Null",
          "text": "Nobody moved. Four hundred people, standing completely still in the dark, in a dead reactor, waiting.",
          "startMs": 7387
        },
        {
          "speaker": "Null",
          "text": "It was the best second of the night.",
          "startMs": 15123
        },
        {
          "speaker": "Null",
          "text": "The music came back. Four hundred people came back with it.",
          "startMs": 18712
        },
        {
          "speaker": "Null",
          "text": "Cause of the stop: unknown. Will not be repeated.",
          "startMs": 23847
        },
        {
          "speaker": "Null",
          "text": "Probably. Logged.",
          "startMs": 28667
        }
      ]
    },
