    {
      "id": "psa-001",
      "category": "psa",
      "url": "/voice/substation-null/psa-001.mp3",
      "durationMs": 12923,
      "title": "Coolant Is Not a Beverage",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Diligence Safety System",
          "text": "Attention, crew of the Diligence. Coolant is not a beverage. It is blue, it glows, and it is served from a pipe. None of these things make it a beverage.",
          "startMs": 49
        },
        {
          "speaker": "Diligence Safety System",
          "text": "Thank you for your cooperation.",
          "startMs": 8971
        },
        {
          "speaker": "Null",
          "text": "Noted.",
          "startMs": 12097
        }
      ]
    },
    {
      "id": "psa-002",
      "category": "psa",
      "url": "/voice/substation-null/psa-002.mp3",
      "durationMs": 16036,
      "title": "The Reactor Is Dormant",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Diligence Safety System",
          "text": "This is a reminder that the main reactor is in a dormant state. Dormant is not the same as asleep.",
          "startMs": 42
        },
        {
          "speaker": "Diligence Safety System",
          "text": "Please do not tuck the reactor in. Please do not read the reactor stories. The reactor does not require a goodnight.",
          "startMs": 5933
        },
        {
          "speaker": "Null",
          "text": "It liked the stories.",
          "startMs": 14417
        }
      ]
    },
    {
      "id": "psa-003",
      "category": "psa",
      "url": "/voice/substation-null/psa-003.mp3",
      "durationMs": 14804,
      "title": "Hazard Lighting",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Diligence Safety System",
          "text": "Some sections of this vessel contain flashing hazard lights. These lights indicate an emergency.",
          "startMs": 49
        },
        {
          "speaker": "Diligence Safety System",
          "text": "They have indicated an emergency continuously for forty years. At this point, please treat them as decoration.",
          "startMs": 5911
        },
        {
          "speaker": "Null",
          "text": "Correct.",
          "startMs": 13814
        }
      ]
    },
    {
      "id": "psa-004",
      "category": "psa",
      "url": "/voice/substation-null/psa-004.mp3",
      "durationMs": 15083,
      "title": "Muster Stations",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Diligence Safety System",
          "text": "In the event of an emergency, please proceed calmly to your nearest muster station. Your nearest muster station is the dance floor.",
          "startMs": 40
        },
        {
          "speaker": "Diligence Safety System",
          "text": "All muster stations are the dance floor. This was not the original plan.",
          "startMs": 7748
        },
        {
          "speaker": "Null",
          "text": "It is now.",
          "startMs": 13769
        }
      ]
    },
    {
      "id": "story-001",
      "category": "story",
      "url": "/voice/substation-null/story-001.mp3",
      "durationMs": 24050,
      "title": "Incident Report: The Glow Stick",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Null",
          "text": "Incident report.",
          "startMs": 41
        },
        {
          "speaker": "Null",
          "text": "Someone brought a glow stick. Green.",
          "startMs": 2690
        },
        {
          "speaker": "Null",
          "text": "The reactor saw it. Core output rose by two percent.",
          "startMs": 6465
        },
        {
          "speaker": "Null",
          "text": "The glow stick was asked to leave. It did not leave. It cannot walk.",
          "startMs": 11550
        },
        {
          "speaker": "Null",
          "text": "It is now on the console. The reactor is calmer when it can see it.",
          "startMs": 17284
        },
        {
          "speaker": "Null",
          "text": "Resolved.",
          "startMs": 22954
        }
      ]
    },
    {
      "id": "story-002",
      "category": "story",
      "url": "/voice/substation-null/story-002.mp3",
      "durationMs": 27617,
      "title": "Incident Report: A Question",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Null",
          "text": "Incident report.",
          "startMs": 41
        },
        {
          "speaker": "Null",
          "text": "A man on the catwalk asked what kind of music this is.",
          "startMs": 2690
        },
        {
          "speaker": "Null",
          "text": "I said, yes.",
          "startMs": 7626
        },
        {
          "speaker": "Null",
          "text": "He left.",
          "startMs": 10413
        },
        {
          "speaker": "Null",
          "text": "He came back.",
          "startMs": 13695
        },
        {
          "speaker": "Null",
          "text": "He has not asked again.",
          "startMs": 16265
        },
        {
          "speaker": "Null",
          "text": "He comes every night. He stands where he stood. He nods at me. I nod back.",
          "startMs": 19279
        },
        {
          "speaker": "Null",
          "text": "That is the answer. Resolved.",
          "startMs": 25207
        }
      ]
    },
    {
      "id": "story-003",
      "category": "story",
      "url": "/voice/substation-null/story-003.mp3",
      "durationMs": 30341,
      "title": "Incident Report: A Smile",
      "overMusic": false,
      "lines": [
        {
          "speaker": "Null",
          "text": "Incident report. Hour three. Peak load.",
          "startMs": 41
        },
        {
          "speaker": "Null",
          "text": "A smile was observed in the crowd. Source unknown.",
          "startMs": 4009
        },
        {
          "speaker": "Null",
          "text": "It spread.",
          "startMs": 9111
        },
        {
          "speaker": "Null",
          "text": "By hour four, eleven smiles. Containment was not attempted.",
          "startMs": 11916
        },
        {
          "speaker": "Null",
          "text": "Hour five. The smiles reached the catwalk. A man laughed out loud. The steam pipes rattled.",
          "startMs": 17753
        },
        {
          "speaker": "Null",
          "text": "No damage. Some things should be allowed to vent.",
          "startMs": 24957
        },
        {
          "speaker": "Null",
          "text": "Resolved.",
          "startMs": 29249
        }
      ]
