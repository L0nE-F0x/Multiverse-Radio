      "daypart": "morning",
      "lines": [
        {
          "speaker": "Johnny Mirror",
          "text": "Good morning! It's the Mirror World Polka Hour!",
          "startMs": 35
        },
        {
          "speaker": "Ynnhoj",
          "text": "Good night!",
          "startMs": 3594
        },
        {
          "speaker": "Johnny Mirror",
          "text": "Ynnhoj.",
          "startMs": 4806
        },
        {
          "speaker": "Ynnhoj",
          "text": "Good morning.",
